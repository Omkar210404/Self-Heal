# selfheal configuration. Copy this file to .env and fill in your own values.
# .env is git-ignored. Never put real values in this file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# true = fake WhatsApp, fake AI and fake GitHub (no keys needed). Same as `npm run mock`.
MOCK_MODE=false
PORT=3000
# Interface to listen on. Use 0.0.0.0 only if you put the server behind a proxy you trust.
HOST=127.0.0.1
# Public base URL of this server (your ngrok or real domain). Used for links in WhatsApp and PRs.
PUBLIC_URL=https://your-subdomain.ngrok-free.app
# Where the SQLite database and temporary clones live.
DATA_DIR=./data
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Error ingestion (browser snippet -> POST /api/errors)
# ---------------------------------------------------------------------------
# Any long random string. It goes in the snippet tag, so treat it as an ingest key, not a password.
PROJECT_KEY=replace-with-a-long-random-string
# Comma-separated site origins allowed to send errors, or * for any.
ALLOWED_ORIGINS=https://your-site.example
# Max requests per minute per IP to /api/errors.
INGEST_RATE_LIMIT_PER_MIN=120
# Max request body size in KB.
INGEST_MAX_BODY_KB=64
# Serve the demo site at /demo (always on in mock mode).
DEMO_ENABLED=false

# ---------------------------------------------------------------------------
# Notifications: email (works now), whatsapp (coming soon), or mock (fake phone in the dashboard)
# ---------------------------------------------------------------------------
NOTIFY_CHANNEL=email
# Where alerts go
OWNER_EMAIL=you@example.com
# SMTP account that sends them. Gmail: your address + an App Password (see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=

# ---------------------------------------------------------------------------
# WhatsApp (Meta WhatsApp Cloud API), used when NOTIFY_CHANNEL=whatsapp
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any string you choose; type the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
# Your own WhatsApp number in international format, digits only, no + sign.
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
# Approved template used when the 24-hour window is closed (see README).
WHATSAPP_TEMPLATE_NAME=selfheal_alert
WHATSAPP_TEMPLATE_LANG=en
# true if your template has one body variable {{1}}; false for a template with no variables (like hello_world).
WHATSAPP_TEMPLATE_HAS_BODY_PARAM=true
WHATSAPP_API_VERSION=v23.0
# Max individual alerts per hour; extra issues are bundled into one summary message.
MAX_ALERTS_PER_HOUR=5

# ---------------------------------------------------------------------------
# AI providers (at least one must be configured)
# ---------------------------------------------------------------------------
# Order to try them in. Missing keys are skipped automatically.
AI_PROVIDERS=gemini,claude,ollama
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=your-gemini-api-key
# Comma list = backups tried in order when a model is overloaded or retired
GEMINI_MODEL=gemini-flash-latest,gemini-3-flash-preview
# Ollama runs locally and needs no key. Leave OLLAMA_MODEL empty to disable it.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_TIMEOUT_MS=120000
# Daily caps (UTC day). When either is reached, fixing pauses and you get a WhatsApp message.
AI_DAILY_MAX_COST_USD=2
AI_DAILY_MAX_CALLS=60
# Price estimates in USD per million tokens, used for the cost cap. Check your provider's pricing page.
CLAUDE_PRICE_INPUT_PER_MTOK=3
CLAUDE_PRICE_OUTPUT_PER_MTOK=15
GEMINI_PRICE_INPUT_PER_MTOK=1.5
GEMINI_PRICE_OUTPUT_PER_MTOK=7.5
OLLAMA_PRICE_INPUT_PER_MTOK=0
OLLAMA_PRICE_OUTPUT_PER_MTOK=0

# ---------------------------------------------------------------------------
# Fix safety limits
# ---------------------------------------------------------------------------
FIX_MAX_ATTEMPTS=3
FIX_MAX_FILES=3
FIX_MAX_LINES=80
# Approximate token budget for source files sent to the AI.
CONTEXT_TOKEN_BUDGET=12000
# Extra comma-separated globs the AI may never see or change (added to the built-in list).
DENYLIST=
# Extra comma-separated globs the AI may read but never change (tests are read-only by default).
READONLY_PATHS=
# Path prefixes to try when mapping a URL path like /assets/app.js to a repo file.
REPO_PATH_PREFIXES=public/,src/,static/,app/

# ---------------------------------------------------------------------------
# GitHub (fine-grained token: Contents read/write + Pull requests read/write, one repo)
# Leave GITHUB_TOKEN and GITHUB_REPO empty to try selfheal on a local test repo (seeded from demo/site).
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your-fine-grained-github-token
# owner/name of your site's repository
GITHUB_REPO=your-github-user/your-site-repo
# Leave empty to use the repository's default branch.
GITHUB_BASE_BRANCH=
GITHUB_API_URL=https://api.github.com
# squash, merge or rebase
MERGE_METHOD=squash
GIT_AUTHOR_NAME=selfheal-bot
GIT_AUTHOR_EMAIL=selfheal-bot@users.noreply.github.com
# Command that runs your repo's tests. Leave empty if the repo has no tests (PRs will be marked UNTESTED).
TEST_COMMAND=npm test
# Optional command run before tests, e.g. npm ci
INSTALL_COMMAND=
TEST_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=choose-a-strong-password
# Optional; a random one is generated at each start if empty (you then log in again after restarts).
SESSION_SECRET=
